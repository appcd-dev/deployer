apiVersion: batch/v1
kind: Job
metadata:
  name: $name-job
  namespace: $namespace
  labels:
    app.kubernetes.io/instance: $name
spec:
  template:
    spec:
      serviceAccountName: $operatorServiceAccount
      restartPolicy: Never
      containers:
        - name: terraform-runner
          image: $terraformRunnerImage
          command: ["/data/deploy.sh"]
          env:
            - name: SUFFIX
              value: $suffix
            - name: DOMAIN
              value: $domain
            - name: STACKGEN_PAT
              value: $stackgenPat
            - name: PRE_SHARED_CERT_NAME
              value: $pre_shared_cert_name
            - name: GLOBAL_STATIC_IP_NAME
              value: $global_static_ip_name
            - name: GUILD_ENABLED
              value: "$guildEnabled"
            - name: APPCD_VERSION
              value: "$appcdVersion"
            - name: IACGEN_VERSION
              value: "$iacgenVersion"
            - name: UI_VERSION
              value: "$uiVersion"
            - name: EXPORTER_VERSION
              value: "$exporterVersion"
            - name: LLM_GATEWAY_VERSION
              value: "$llmGatewayVersion"
            - name: VAULT_VERSION
              value: "$vaultVersion"
            - name: GUILD_VERSION
              value: "$guildVersion"
            - name: GATEWAY_VERSION
              value: "$gatewayVersion"
            - name: GUILD_UI_VERSION
              value: "$guildUiVersion"
          volumeMounts:
            - name: deployer-config
              mountPath: /data/values
              readOnly: true
      volumes:
        - name: deployer-config
          secret:
            secretName: $name-deployer-config
